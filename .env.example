# Nirman Mitra — environment variables
# Copy to .env for local work. Never commit real values.
# On Render these are set per service (see render.yaml); for the Lambda stack, as SAM parameters.

ENVIRONMENT=dev

# ── Backends (render.yaml sets postgres / disk / tesseract / none) ──
# Left unset: the in-memory demo store locally (ENVIRONMENT=dev), the AWS services when hosted.
# DB_BACKEND: postgres | dynamodb | memory
DB_BACKEND=postgres
DATABASE_URL=postgres://user:pass@host:5432/nirman_mitra
# STORAGE_BACKEND: disk | s3 | memory
STORAGE_BACKEND=disk
STORAGE_DIR=./data/files
# Signs the expiring /files/ links; PUBLIC_BASE_URL is the API's address (Render sets
# RENDER_EXTERNAL_URL instead)
FILE_URL_SECRET=generate-a-long-random-string
PUBLIC_BASE_URL=http://localhost:3001
# OCR_PROVIDER: tesseract | textract
OCR_PROVIDER=tesseract
# TTS_FALLBACK: none | polly
TTS_FALLBACK=none

# ── AWS (Rekognition face matching only, on Render) ──
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Days of verified attendance required for a certificate (3 for demos, 90 in production)
CERTIFICATE_THRESHOLD=3

# Public dashboard / officer portal URL; certificate QR codes link to <PORTAL_URL>/verify/<hash>
PORTAL_URL=

# Team phone numbers allowed to use the "demo cert" / "test review" keywords (comma-separated)
DEMO_PHONE_NUMBERS=

# Issuer ES256 private key for signed work credentials (JWK JSON, or base64 of it). The matching
# public key is published in admin-dashboard/public/.well-known/did.json
CREDENTIAL_SIGNING_JWK=

# ── WhatsApp Cloud API (Meta developer console) ─────
WHATSAPP_API_TOKEN=your-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=choose-a-random-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_REMINDER_TEMPLATE_NAME=daily_checkin_reminder

# ── LLM (Nodus Compute primary, Groq fallback) ──────
LLM_PROVIDER=nodus
LLM_MODEL=nodus/gpt-oss-120b
NODUS_API_KEY=your-nodus-api-key
# Tried once when the primary fails (defaults to groq when LLM_PROVIDER=nodus)
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your-groq-api-key

# ── Speech-to-text chain (providers without a key are skipped) ──
STT_PROVIDERS=nodus,elevenlabs,groq
NODUS_STT_MODEL=openai/whisper-large-v3
ELEVENLABS_STT_MODEL=scribe_v1

# ── ElevenLabs ──────────────────────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Voice per language (JSON). Languages without a voice get text-only replies (or Polly for
# hi/en when TTS_FALLBACK=polly).
ELEVENLABS_VOICE_IDS={"en":"voice-id","hi":"voice-id"}
ELEVENLABS_TTS_MODEL=eleven_v3

# ── Data and files on Neon (no AWS account needed) ──
# Pooled Postgres connection string from the Neon console → Connect
DB_BACKEND=postgres
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Neon object storage (S3-compatible). Create the three buckets once:
#   nirman-mitra-media-raw, nirman-mitra-media-processed, nirman-mitra-certificates
STORAGE_BACKEND=s3
AWS_ENDPOINT_URL_S3=https://br-xxxx.storage.region.aws.neon.tech
AWS_ACCESS_KEY_ID=nak_live_xxxx
AWS_SECRET_ACCESS_KEY=nsk_live_xxxx
AWS_REGION=ap-southeast-1

# ── Face matching ───────────────────────────────────
# bridge (OpenCV SFace on nodus/bridge.py, no AWS) | rekognition (AWS) | none (officer review).
# Default: bridge when FRAUD_SERVICE_URL/TOKEN are set, else rekognition with AWS keys, else none.
FACE_PROVIDER=bridge

# ── Nodus fraud service (nodus/bridge.py) ──────────
# Empty URL disables the selfie fraud check; check-ins then use triple verification alone
FRAUD_SERVICE_URL=
FRAUD_SERVICE_TOKEN=generate-a-random-token
FRAUD_SERVICE_TIMEOUT_MS=6000
# Keys the hash of each exact GPS fix (defaults to JWT_SECRET)
GPS_HASH_KEY=

# ── Agent37 ops agent ───────────────────────────────
# SHA-256 of the key the agent sends as X-Agent-Key:  echo -n "$KEY" | sha256sum
AGENT_API_KEY_HASH=

# ── ElevenLabs Mitra Helpline agent ─────────────────
# Sent by the agent's server tools as the X-Helpline-Secret header
HELPLINE_SECRET=generate-a-random-secret

# ── Admin authentication ────────────────────────────
JWT_SECRET=generate-a-long-random-string
JWT_REFRESH_SECRET=generate-another-long-random-string
ADMIN_SEED_SECRET=generate-a-seed-secret

# ── Face verification ───────────────────────────────
REKOGNITION_COLLECTION_ID=nirman-mitra-workers

# ── Admin dashboard (admin-dashboard/.env) ──────────
VITE_API_URL=https://nirman-mitra-api.onrender.com
