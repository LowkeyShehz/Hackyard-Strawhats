# Nirman Mitra — environment variables
# Copy to .env for local work. Never commit real values.
# In AWS these are supplied as SAM parameters (see template.yaml).

# ── AWS ─────────────────────────────────────────────
AWS_REGION=ap-south-1
ENVIRONMENT=dev

# Days of verified attendance required for a certificate (3 for demos, 90 in production)
CERTIFICATE_THRESHOLD=3

# Public dashboard / officer portal URL; certificate QR codes link to <PORTAL_URL>/verify/<hash>
PORTAL_URL=

# Team phone numbers allowed to use the "demo cert" / "test review" keywords (comma-separated)
DEMO_PHONE_NUMBERS=

# Issuer ES256 private key for signed work credentials (JWK JSON, or base64 of it). The matching
# public key is published in admin-dashboard/public/.well-known/did.json
CREDENTIAL_SIGNING_JWK=

# ── WhatsApp Cloud API (Meta developer console) ─────
WHATSAPP_API_TOKEN=your-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=choose-a-random-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_REMINDER_TEMPLATE_NAME=daily_checkin_reminder

# ── LLM (Groq) ──────────────────────────────────────
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your-groq-api-key

# ── Admin authentication ────────────────────────────
JWT_SECRET=generate-a-long-random-string
JWT_REFRESH_SECRET=generate-another-long-random-string
ADMIN_SEED_SECRET=generate-a-seed-secret

# ── Face verification ───────────────────────────────
REKOGNITION_COLLECTION_ID=nirman-mitra-workers

# ── Admin dashboard (admin-dashboard/.env) ──────────
VITE_API_URL=https://your-api-id.execute-api.ap-south-1.amazonaws.com/dev
